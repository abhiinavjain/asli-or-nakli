# copy to .env and fill in
PG_MAJOR=16                       # same major version as your laptops (SELECT version();)
PG_PASSWORD=change-me-long-random
DOMAIN=asli-or-nakli.duckdns.org  # a domain/subdomain pointing at the server's IP
SITE_USER=demo
# hash for the site login:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# in this file write every $ in the hash as $$
SITE_PASSWORD_HASH=
ANTHROPIC_API_KEY=                # optional: leave empty for the rule-based answer
